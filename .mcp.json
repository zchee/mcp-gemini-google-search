{
  "mcpServers": {
    "mcp-gemini-search": {
      "command": "uvx",
      "args": [
        "--prerelease=allow",
        "--from",
        "git+https://github.com/zchee/mcp-gemini-search",
        "mcp-gemini-search"
      ],
      "env": {
        "MCP_GEMINI_GOOGLE_API_KEY": "${GOOGLE_API_KEY:-}",
        "MCP_GEMINI_GEMINI_API_KEY": "${GEMINI_API_KEY:-}"
      },
      "startup_timeout_sec": 60
    }
  }
}
